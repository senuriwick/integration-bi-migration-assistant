<sequence xmlns="http://ws.apache.org/ns/synapse" name="HttpInboundSeq">
    <log level="custom" category="INFO">
        <property name="message" value="Inbound request received"/>
    </log>
    <payloadFactory media-type="json">
        <format>{"status": "received", "message": "Hello from HTTP Inbound Endpoint"}</format>
    </payloadFactory>
    <property name="HTTP_SC" value="200" scope="axis2"/>
    <respond/>
</sequence>
