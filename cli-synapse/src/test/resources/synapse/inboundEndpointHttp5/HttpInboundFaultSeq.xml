<sequence xmlns="http://ws.apache.org/ns/synapse" name="HttpInboundFaultSeq">
    <log level="custom" category="ERROR">
        <property name="message" value="Inbound error"/>
        <property name="errorMessage" expression="get-property('ERROR_MESSAGE')"/>
    </log>
    <payloadFactory media-type="json">
        <format>{"status": "error", "message": "${properties.synapse.ERROR_MESSAGE}"}</format>
    </payloadFactory>
    <property name="HTTP_SC" value="500" scope="axis2"/>
    <respond/>
</sequence>
