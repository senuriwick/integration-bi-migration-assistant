<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <pd:name>Processes/Caller.process</pd:name>
    <pd:startName>HTTP Receiver</pd:startName>
    <pd:returnBindings>
        <Response>
            <greeting>
                <xsl:value-of select="$Use-Result/Reply"/>
            </greeting>
        </Response>
    </pd:returnBindings>
    <pd:starter name="HTTP Receiver">
        <pd:type>com.tibco.plugin.http.HTTPEventSource</pd:type>
        <pd:resourceType>httppalette.httpEventSource</pd:resourceType>
        <config>
            <outputMode>String</outputMode>
            <defaultEncoding>ISO8859_1</defaultEncoding>
            <inputOutputVersion>5.3.0</inputOutputVersion>
            <newMimeSupport>true</newMimeSupport>
            <sharedChannel>/SubprocessReturnBindings/SharedResources/CallerConnection.sharedhttp</sharedChannel>
            <parsePostData>true</parsePostData>
        </config>
        <pd:inputBindings/>
    </pd:starter>
    <pd:endName>End</pd:endName>
    <pd:errorSchemas/>
    <pd:targetNamespace>http://xmlns.example.com/1357991310274</pd:targetNamespace>
    <pd:activity name="Sub">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <config>
            <processName>/Processes/Sub.process</processName>
        </config>
        <pd:inputBindings>
            <root>
                <name>
                    <xsl:value-of select="$post/item/name"/>
                </name>
            </root>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Use Result">
        <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
        <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
        <config>
            <element>
                <xsd:element name="Reply" type="xsd:string"/>
            </element>
        </config>
        <pd:inputBindings>
            <Reply>
                <xsl:value-of select="$Sub/Out/value"/>
            </Reply>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>HTTP Receiver</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>HTTP Receiver</pd:from>
        <pd:to>Sub</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Sub</pd:from>
        <pd:to>Use Result</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Use Result</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>
